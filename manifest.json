{
  "manifest_version": 3,
  "name": "Autofill-pro FX",
  "version": "0.2.0",
  "description": "Capture, inspect, and manually replay complex web form values for FX workflows.",
  "icons": {
    "16": "assets/fx-icon-16.png",
    "32": "assets/fx-icon-32.png",
    "48": "assets/fx-icon-48.png",
    "128": "assets/fx-icon-128.png"
  },
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "debugger"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "Autofill-pro FX",
    "default_icon": {
      "16": "assets/fx-icon-16.png",
      "32": "assets/fx-icon-32.png"
    },
    "default_popup": "popup/popup.html"
  },
  "options_page": "options/options.html",
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
